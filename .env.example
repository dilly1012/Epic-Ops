# CourtReserve: Settings > Additional Features > Integrations > API Access
# Username looks like Org_12345. Start with a read-only key.
COURTRESERVE_USERNAME=
COURTRESERVE_PASSWORD=
COURTRESERVE_BASE_URL=https://api.courtreserve.com

# Ids of the member custom fields "Epic Rating" (3.62) and "Reliability" (85%)
# (GET /api/v1/membercustomfield/get)
CR_EPIC_RATING_FIELD_ID=
CR_RELIABILITY_FIELD_ID=

# Set to true only after the key has write access to members
CR_WRITE_ENABLED=false

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
